#!/usr/bin/env python3
"""Fake dmenu-style launcher: reads the menu from stdin and answers with the index of the line starting with $FAKE_CHOICE."""
import json, os, sqlite3, sys
lines = sys.stdin.read().split("\n")
open(os.environ["STUB_LOG"], "a").write(json.dumps({"tool": "fuzzel", "argv": sys.argv[1:], "lines": lines}) + "\n")
if os.environ.get("FAKE_INSERT_REEL"):  # a reel that arrives while the menu is open
    db = sqlite3.connect(os.path.join(os.environ["WA_NOTIFY_DATA_DIR"], "wa-notify.db"))
    db.execute("INSERT OR IGNORE INTO reels(reel_id, sender, url, is_opened) VALUES (?, 'Late', 'u', 0)", (os.environ["FAKE_INSERT_REEL"],))
    db.commit()
want = os.environ.get("FAKE_CHOICE", "")
for i, line in enumerate(lines):
    if want and line.startswith(want):
        print(i)
        break
else:
    sys.exit(1)
